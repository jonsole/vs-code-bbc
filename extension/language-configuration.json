{
  "comments": {
    "lineComment": "\\"
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[.]?[A-Za-z_][\\w.@]*|&[0-9A-Fa-f]+|\\$[0-9A-Fa-f]+|-?\\d+"
}
