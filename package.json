        },
        {
          "command": "bbcMicro.stepBackOut",
          "when": "debugType == 'bbcmicro' && stepBackSupported"
        },
        {
          "command": "bbcMicro.runBackToCursor",
          "when": "false"
        },
        {
          "command": "bbcMicro.runBackToWrite",
