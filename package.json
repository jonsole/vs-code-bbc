        {
          "command": "bbcMicro.setSpeed",
          "when": "debugType == 'bbcmicro'"
        },
        {
          "command": "bbcMicro.saveSnapshot",
          "when": "debugType == 'bbcmicro'"
        },
        {
          "command": "bbcMicro.profileStart",
          "when": "debugType == 'bbcmicro' && !bbcMicro.profiling"
        },
        {
          "command": "bbcMicro.profileStop",
          "when": "debugType == 'bbcmicro' && bbcMicro.profiling"
        },
        {
          "command": "bbcMicro.profileRefresh",
          "when": "debugType == 'bbcmicro'"
        },
        {
          "command": "bbcMicro.profileMarkIdle",
          "when": "false"
        },
        {
          "command": "bbcMicro.profileUnmarkIdle",
          "when": "false"
        },
        {
          "command": "bbcMicro.profileShowPeriod",
          "when": "false"
        },
        {
          "command": "bbcMicro.profileShowAll",
          "when": "bbcMicro.profileShowingPeriod"
        }
      ],
      "view/item/context": [
        {
          "command": "bbcMicro.toggleWatchpoint",
          "when": "view == bbcMicroWatchpoints && viewItem == bbcWatchpoint",
          "group": "inline@1"
        },
        {
          "command": "bbcMicro.clearWatchpoint",
          "when": "view == bbcMicroWatchpoints && viewItem == bbcWatchpoint",
          "group": "inline@2"
        },
        {
          "command": "bbcMicro.profileMarkIdle",
          "when": "view == bbcMicroProfile && viewItem == bbcProfileRoutine",
          "group": "profile@1"
        },
        {
          "command": "bbcMicro.profileUnmarkIdle",
          "when": "view == bbcMicroProfile && viewItem == bbcProfileIdleRoutine",
          "group": "profile@1"
        },
        {
          "command": "bbcMicro.profileShowPeriod",
          "when": "view == bbcMicroProfile && viewItem == bbcProfilePeriod",
          "group": "inline"
        },
        {
          "command": "bbcMicro.profileShowAll",
          "when": "view == bbcMicroProfile && viewItem == bbcProfilePeriods && bbcMicro.profileShowingPeriod",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "bbcMicro.watchAddress",
          "when": "view == bbcMicroWatchpoints",
          "group": "navigation@1"
        },
        {
          "command": "bbcMicro.clearWatchpoints",
          "when": "view == bbcMicroWatchpoints && bbcMicro.hasWatchpoints",
          "group": "navigation@2"
        },
        {
          "command": "bbcMicro.profileStart",
          "when": "view == bbcMicroProfile && !bbcMicro.profiling",
          "group": "navigation@1"
        },
        {
          "command": "bbcMicro.profileStop",
          "when": "view == bbcMicroProfile && bbcMicro.profiling",
          "group": "navigation@1"
        },
        {
          "command": "bbcMicro.profileSortBySelf",
          "when": "view == bbcMicroProfile && bbcMicro.profileSort != 'self'",
          "group": "navigation@2"
        },
        {
          "command": "bbcMicro.profileSortByTotal",
          "when": "view == bbcMicroProfile && bbcMicro.profileSort == 'self'",
          "group": "navigation@2"
        },
        {
          "command": "bbcMicro.profileHotSpots",
          "when": "view == bbcMicroProfile && bbcMicro.hasProfile",
          "group": "navigation@3"
        },
        {
          "command": "bbcMicro.profileClear",
          "when": "view == bbcMicroProfile && bbcMicro.hasProfile && !bbcMicro.profiling",
          "group": "navigation@4"
        },
        {
          "command": "bbcMicro.profileShowAll",
          "when": "view == bbcMicroProfile && bbcMicro.profileShowingPeriod",
          "group": "navigation@0"
        },
        {
          "command": "bbcMicro.profileSetIdle",
          "when": "view == bbcMicroProfile",
          "group": "profile@1"
        },
        {
          "command": "bbcMicro.profileSetPeriod",
          "when": "view == bbcMicroProfile",
          "group": "profile@2"
        },
        {
          "command": "bbcMicro.profileTintOwnCode",
          "when": "view == bbcMicroProfile && bbcMicro.profileCumulative",
          "group": "profile@3"
        },
        {
          "command": "bbcMicro.profileTintWithCalls",
          "when": "view == bbcMicroProfile && !bbcMicro.profileCumulative",
          "group": "profile@3"
        }
      ],
      "debug/toolBar": [
        {
          "command": "bbcMicro.stepBackInto",
          "when": "debugType == 'bbcmicro' && stepBackSupported",
          "group": "navigation@0"
        },
        {
          "command": "bbcMicro.stepBackOut",
          "when": "debugType == 'bbcmicro' && stepBackSupported",
          "group": "navigation@0"
        },
        {
          "command": "bbcMicro.returnToLive",
          "when": "debugType == 'bbcmicro' && bbcMicro.inPast",
          "group": "navigation@0"
        },
        {
          "command": "bbcMicro.setSpeed",
          "when": "debugType == 'bbcmicro'",
          "group": "navigation@1"
        },
        {
          "command": "bbcMicro.profileStart",
          "when": "debugType == 'bbcmicro' && !bbcMicro.profiling",
          "group": "navigation@2"
        },
        {
          "command": "bbcMicro.profileStop",
          "when": "debugType == 'bbcmicro' && bbcMicro.profiling",
          "group": "navigation@2"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "bbcMicro.mcp",
        "label": "BBC Micro emulator"
      }
    ],
    "configuration": {
      "title": "BBC Micro",
      "properties": {
        "bbcMicro.server.dapPort": {
          "type": "number",
          "default": 4811,
          "markdownDescription": "The port the emulator serves the Debug Adapter Protocol on (`--dap-port`). Launch configurations without `ports` connect here."
        },
        "bbcMicro.server.httpPort": {
          "type": "number",
          "default": 8811,
          "markdownDescription": "The port the emulator serves MCP (`/mcp`), the screen and the sound on (`--http-port`)."
        },
        "bbcMicro.server.model": {
          "type": "string",
          "default": "B-DFS1.2",
          "markdownDescription": "The model a started emulator is (`--model`); a launch configuration's `model` overrides it."
        },
        "bbcMicro.server.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Run the emulator with this Node.js (22 or later) instead of VS Code's own."
        },
        "bbcMicro.screen.showOnDebug": {
          "type": "boolean",
          "default": true,
          "description": "Open the screen panel when a BBC Micro debug session starts."
        },
        "bbcMicro.screen.filter": {
          "type": "string",
          "enum": [
            "nearest",
            "sharp-bilinear",
            "bilinear"
          ],
          "enumDescriptions": [
            "Hard-edged pixels, as the video ULA drew them. Uneven at in-between sizes.",
            "Hard-edged pixels, evenly sized at any size: nearest neighbour to a whole multiple, then bilinear for the rest.",
            "Smoothed, as a television would soften it."
          ],
          "default": "nearest",
          "description": "How the screen panel scales the BBC's picture."
        },
        "bbcMicro.screen.scale": {
          "type": "string",
          "enum": [
            "fit-integer",
            "fit",
            "1",
            "2"
          ],
          "enumDescriptions": [
            "As large as the panel allows in whole steps, so every pixel is the same size; scaled down smoothly in a panel too small for 1x.",
            "Fill the panel, keeping the shape.",
            "896 x 600: jsbeeb's frame as it is",
            "1792 x 1200"
          ],
          "default": "fit-integer",
          "description": "How large the screen panel draws the BBC's picture, border included."
        },
        "bbcMicro.screen.scanlines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "markdownDescription": "How dark the gaps between the screen panel's scanlines are, as a percentage: `0` is off, `100` black. Drawn over the lower half of each BBC line, after the filter. Needs at least two device pixels to a line, so it shows nothing at `1x` on an unscaled display."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2"
  }
}
