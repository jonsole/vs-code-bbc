    "views": {
      "debug": [
        {
          "id": "bbcMicroProfile",
          "name": "BBC Micro Profile",
          "when": "debugType == 'bbcmicro' || bbcMicro.hasProfile"
        },
        {
          "id": "bbcMicroWatchpoints",
          "name": "BBC Micro Watchpoints",
          "when": "debugType == 'bbcmicro'"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bbcMicroWatchpoints",
        "contents": "Nothing is being watched.\n[Watch Address...](command:bbcMicro.watchAddress)\nA watchpoint stops the machine when the program reads or writes an address. VS Code's own, set from the memory inspector or the Variables pane, are listed here too."
      },
      {
        "view": "bbcMicroProfile",
        "contents": "Nothing profiled yet.\n[Start Profiling](command:bbcMicro.profileStart)\nCounts where the time goes while the program runs, without stopping it: hot lines are tinted in the source, and the call tree is here."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bbcMicro.runBackToCursor",
          "when": "debugType == 'bbcmicro' && stepBackSupported && (editorLangId == beebasm || resourceExtname =~ /^\\.(6502|beebasm|asm|s|inc)$/)",
          "group": "debug@3"
        },
        {
          "command": "bbcMicro.runBackToWrite",
          "when": "debugType == 'bbcmicro' && stepBackSupported && (editorLangId == beebasm || resourceExtname =~ /^\\.(6502|beebasm|asm|s|inc)$/)",
          "group": "debug@4"
        },
        {
          "command": "bbcMicro.watchAddress",
          "when": "debugType == 'bbcmicro' && (editorLangId == beebasm || resourceExtname =~ /^\\.(6502|beebasm|asm|s|inc)$/)",
          "group": "debug@5"
        }
      ],
      "editor/title": [
        {
          "command": "bbcMicro.showScreen",
          "when": "debugType == 'bbcmicro' && !(activeWebviewPanelId == 'bbcMicroScreen')",
          "group": "navigation"
        },
        {
          "command": "bbcMicro.typeText",
          "when": "activeWebviewPanelId == 'bbcMicroScreen'",
          "group": "navigation@1"
        },
        {
          "command": "bbcMicro.screenScaling",
          "when": "activeWebviewPanelId == 'bbcMicroScreen'",
          "group": "navigation@2"
        },
        {
          "command": "bbcMicro.pressBreak",
          "when": "activeWebviewPanelId == 'bbcMicroScreen'",
          "group": "navigation@3"
        },
        {
          "command": "bbcMicro.powerCycle",
          "when": "activeWebviewPanelId == 'bbcMicroScreen'",
          "group": "machine@1"
        },
        {
          "command": "bbcMicro.setSpeed",
          "when": "activeWebviewPanelId == 'bbcMicroScreen' && debugType == 'bbcmicro'",
          "group": "machine@2"
        },
        {
          "command": "bbcMicro.saveSnapshot",
          "when": "activeWebviewPanelId == 'bbcMicroScreen' && debugType == 'bbcmicro'",
          "group": "machine@3"
        }
      ],
      "explorer/context": [
        {
          "command": "bbcMicro.runFile",
          "when": "resourceExtname =~ /^\\.(ssd|dsd|uef|bas)$/i",
          "group": "navigation@90"
        },
        {
          "command": "bbcMicro.debugFile",
          "when": "resourceExtname =~ /^\\.(ssd|dsd|uef|bas)$/i",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "bbcMicro.runFile",
          "when": "false"
        },
        {
          "command": "bbcMicro.debugFile",
          "when": "false"
        },
        {
          "command": "bbcMicro.serverMenu",
          "when": "false"
        },
        {
          "command": "bbcMicro.serverStop",
          "when": "bbcMicro.serverRunning"
        },
        {
          "command": "bbcMicro.serverRestart",
          "when": "bbcMicro.serverRunning"
        },
        {
          "command": "bbcMicro.watchAddress",
          "when": "debugType == 'bbcmicro'"
        },
        {
          "command": "bbcMicro.clearWatchpoint",
          "when": "false"
        },
        {
          "command": "bbcMicro.toggleWatchpoint",
          "when": "false"
        },
        {
