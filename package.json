        "category": "BBC Micro"
      },
      {
        "command": "bbcMicro.screenScaling",
        "title": "Screen Scaling...",
        "icon": "$(zoom-in)",
        "category": "BBC Micro"
      },
      {
        "command": "bbcMicro.typeText",
        "title": "Type Text at the Keyboard...",
        "icon": "$(keyboard)",
        "category": "BBC Micro"
      },
      {
        "command": "bbcMicro.pressBreak",
        "title": "Press BREAK",
        "icon": "$(debug-restart)",
        "category": "BBC Micro"
      },
      {
        "command": "bbcMicro.powerCycle",
        "title": "Power Off and On",
