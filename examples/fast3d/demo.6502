\ demo.6502 -- fast3d's demo: a wireframe cube or icosahedron, turning about
\ all three axes and swinging in towards the eye and out again, in MODE 4,
\ drawn through a window: whatever of it is beyond the window's frame is
\ clipped away. SPACE changes the object.
\
\ Build: beebasm -i demo.6502 -do build/fast3d.ssd -boot DEMO -v -dd -labels build/demo.labels > build/demo.lst
\ (from this directory)
\
\ Each frame is drawn on the screen not being shown -- MODE 4's own at &5800,
\ or a second at &3000 -- then shown at the next vertical sync by moving the
\ CRTC's start address, so nothing ever flickers. Only the box the object
\ took on that screen last time is cleared first.
\
\ Program and tables run from &0E00 to below &3000. DEMO loads at &1900, as
\ a disc file must, and its first act is to copy itself down: the disc
\ filing system's workspace there is not needed again.

oswrch = &FFEE
osbyte = &FFF4
crtc_address = &FE00
crtc_data = &FE01

FAST3D_ZP = &70                 \ &70..&89; the demo's own after
object = &8A                    \ 2: -> the object being shown, in `objects`
space_was = &8C

SCREEN_A = &3000                \ the second screen; MODE 4's own is SCREEN_B
SCREEN_B = &5800
LOAD_AT = &1900
RUN_AT = &0E00
NEAREST = 110                   \ the eye from the object's centre, at its
FARTHEST = 400                  \ closest and farthest
CLIP_LEFT = 24                  \ the window lines are clipped to. clear_box
CLIP_TOP = 24                   \ clears whole character rows and byte
CLIP_RIGHT = 231                \ columns, so the window keeps to them, and
CLIP_BOTTOM = 231               \ its frame, a pixel outside, is never cleared

ORG RUN_AT
GUARD SCREEN_A

INCLUDE "fast3d.6502"     \ first: BeebAsm needs its zero page defined before use

\ draw_frame borrows fast3d's zero page that clip_line and draw_line leave be.
edge_ptr = div_lo               \ 2
edges_left = vptr

.start
{
    lda #22                     \ MODE 4, its cursor off
    jsr oswrch
    lda #4
    jsr oswrch
    ldx #0
.vdu
    lda cursor_off, X
    jsr oswrch
    inx
    cpx #10
    bne vdu
    lda #0                      \ the second screen blank
    sta line_ptr
    lda #HI(SCREEN_A)
    sta line_ptr + 1
    ldx #HI(SCREEN_B - SCREEN_A)
    lda #0
    tay
.blank
    sta (line_ptr), Y
    iny
    bne blank
    inc line_ptr + 1
    dex
    bne blank
    jsr demo_setup
    lda #0
    sta space_was
    lda #LO(objects)
    sta object
    lda #HI(objects)
    sta object + 1
    lda #0
    sta angle_x
    sta angle_y
    sta angle_z

.frame
    jsr draw_frame
    lda #19                     \ wait for the vertical sync
    jsr osbyte
    lda screen_add              \ show what was just drawn; draw on the other
    bne show_b
    ldx #HI(SCREEN_A DIV 8)
    lda #HI(SCREEN_B - SCREEN_A)
    bne show
.show_b
    ldx #HI(SCREEN_B DIV 8)
    lda #0
.show
    sta screen_add
    lda #12
    sta crtc_address
    stx crtc_data
    lda #13
    sta crtc_address
    lda #0
    sta crtc_data
    jsr read_space
    jmp frame

.cursor_off
    EQUB 23, 1, 0, 0, 0, 0, 0, 0, 0, 0
}


\ demo_setup: the window, its frame on both screens, the object at its
\ farthest, and &3000 to be drawn on first. Calls nothing in the OS.
.demo_setup
{
    lda #CLIP_LEFT
    sta line_x0
    lda #CLIP_TOP
    sta line_y0
    lda #CLIP_RIGHT
    sta line_x1
    lda #CLIP_BOTTOM
    sta line_y1
    jsr set_window
    lda #HI(SCREEN_B - SCREEN_A)
    sta screen_add
    jsr draw_frame_lines
    lda #0
    sta screen_add
    jsr draw_frame_lines
    lda #LO(FARTHEST * 128)
    sta zoff
    lda #HI(FARTHEST * 128)
    sta zoff + 1
    lda #LO(-256)               \ 2 units a frame, inwards first
    sta swing
    lda #HI(-256)
    sta swing + 1
    rts
}

\ draw_frame_lines: the window's frame, a pixel outside it, on the screen
\ screen_add says.
.draw_frame_lines
{
    ldx #0
.line
    lda frame_lines, X
    sta line_x0
    lda frame_lines + 1, X
    sta line_y0
    lda frame_lines + 2, X
    sta line_x1
    lda frame_lines + 3, X
    sta line_y1
    stx frame_at
    jsr draw_line
    lda frame_at
    clc
    adc #4
    tax
    cpx #16
    bne line
    rts
.frame_at
    EQUB 0
}

.frame_lines
    EQUB CLIP_LEFT - 1, CLIP_TOP - 1, CLIP_RIGHT + 1, CLIP_TOP - 1
    EQUB CLIP_RIGHT + 1, CLIP_TOP - 1, CLIP_RIGHT + 1, CLIP_BOTTOM + 1
    EQUB CLIP_RIGHT + 1, CLIP_BOTTOM + 1, CLIP_LEFT - 1, CLIP_BOTTOM + 1
    EQUB CLIP_LEFT - 1, CLIP_BOTTOM + 1, CLIP_LEFT - 1, CLIP_TOP - 1

.swing
    EQUW 0
.extent
    SKIP 4                      \ the least x, most x, least y, most y drawn


\ draw_frame: turn the object on and swing it in or out, and draw it on the
\ screen screen_add says, clipped to the window, clearing what it drew there
\ last time. Calls nothing in the OS.
.draw_frame
{
    inc angle_x                 \ turn a little about each axis
    inc angle_y
    inc angle_y
    inc angle_z
    jsr make_matrix

    clc                         \ and swing in or out: 2 units a frame,
    lda zoff                    \ turning at the ends
    adc swing
    sta zoff
    lda zoff + 1
    adc swing + 1
    sta zoff + 1
    lda zoff                    \ (both ends are whole multiples of 256)
    bne swung
    lda zoff + 1
    cmp #HI(NEAREST * 128)
    beq turn
    cmp #HI(FARTHEST * 128)
    bne swung
.turn
    sec
    lda #0
    sbc swing
    sta swing
    lda #0
    sbc swing + 1
    sta swing + 1
.swung

    ldy #0                      \ the vertices to the screen, on it or off it
    lda (object), Y
    sta vptr
    iny
    lda (object), Y
    sta vptr + 1
    iny
    lda (object), Y
    sta count
    lda #LO(points)
    sta pptr
    lda #HI(points)
    sta pptr + 1
    jsr transform_wide

    ldx #0                      \ clear the last box here
    lda screen_add
    beq this_box
    ldx #4
.this_box
    lda boxes, X                \ rows: none, nothing to clear
    beq cleared
    pha
    lda boxes + 2, X
    sta line_x0
    lda boxes + 3, X
    sta line_x1
    lda boxes + 1, X
    tay
    pla
    tax
    tya
    jsr clear_box
.cleared

    lda #&FF                    \ this screen's box, for next time: round every
    sta extent                  \ end drawn
    sta extent + 2
    lda #0
    sta extent + 1
    sta extent + 3

    ldy #3                      \ the edges, clipped
    lda (object), Y
    sta edge_ptr
    iny
    lda (object), Y
    sta edge_ptr + 1
    iny
    lda (object), Y
    sta edges_left
.edge
    ldy #0
    lda (edge_ptr), Y           \ the first end into clip_x0, clip_y0
    asl a
    asl a
    tax
    lda points + 1, X
    cmp #HI(WIDE_BEHIND)
    bne first_in_front
    lda points, X
    beq next                    \ at or behind the eye: leave the edge out
.first_in_front
    lda points, X
    sta clip_x0
    lda points + 1, X
    sta clip_x0 + 1
    lda points + 2, X
    sta clip_y0
    lda points + 3, X
    sta clip_y0 + 1
    iny
    lda (edge_ptr), Y           \ the second into clip_x1, clip_y1
    asl a
    asl a
    tax
    lda points + 1, X
    cmp #HI(WIDE_BEHIND)
    bne second_in_front
    lda points, X
    beq next
.second_in_front
    lda points, X
    sta clip_x1
    lda points + 1, X
    sta clip_x1 + 1
    lda points + 2, X
    sta clip_y1
    lda points + 3, X
    sta clip_y1 + 1
    jsr clip_line
    bcs next                    \ none of it in the window
    lda line_x0                 \ round its ends
    jsr least_x
    lda line_x1
    jsr least_x
    lda line_y0
    jsr least_y
    lda line_y1
    jsr least_y
    jsr draw_line
.next
    lda edge_ptr
    clc
    adc #2
    sta edge_ptr
    bcc same_page
    inc edge_ptr + 1
.same_page
    dec edges_left
    bne edge

    ldx #0                      \ the box, in character rows and byte columns
    lda screen_add
    beq that_box
    ldx #4
.that_box
    lda extent + 2
    cmp #&FF
    bne some
    lda #0                      \ nothing drawn
    sta boxes, X
    rts
.some
    lsr a                       \ character rows
    lsr a
    lsr a
    sta boxes + 1, X
    lda extent + 3
    lsr a
    lsr a
    lsr a
    sec
    sbc boxes + 1, X
    clc
    adc #1
    sta boxes, X
    lda extent                  \ byte columns
    lsr a
    lsr a
    lsr a
    sta boxes + 2, X
    lda extent + 1
    lsr a
    lsr a
    lsr a
    sec
    sbc boxes + 2, X
    clc
    adc #1
    sta boxes + 3, X
    rts

\ extent, extent + 1 = the least and most of them and A; and for y, + 2, + 3.
.least_x
    cmp extent
    bcs not_least_x
    sta extent
.not_least_x
    cmp extent + 1
    bcc not_most_x
    sta extent + 1
.not_most_x
    rts
.least_y
    cmp extent + 2
    bcs not_least_y
    sta extent + 2
.not_least_y
    cmp extent + 3
    bcc not_most_y
    sta extent + 3
.not_most_y
    rts
}

\ The box (character rows, top row, left column, columns) each screen's
\ object took: &3000's, then &5800's.
.boxes
    EQUB 0, 0, 0, 0
    EQUB 0, 0, 0, 0


\ read_space: SPACE, newly down, changes the object.
.read_space
{
    lda #129                    \ INKEY(-99)
    ldx #&9D
    ldy #&FF
    jsr osbyte
    txa
    and #1
    cmp space_was
    beq done
    sta space_was
    tax                         \ (STA sets no flags)
    beq done                    \ it has come up
    lda object
    clc
    adc #OBJECT_SIZE
    cmp #LO(objects_end)
    bne set
    lda #LO(objects)
.set
    sta object
.done
    rts
}

\ Each object: its vertices and how many, its edges and how many.
OBJECT_SIZE = 6
.objects
    EQUW cube_vertices
    EQUB CUBE_VERTICES
    EQUW cube_edges
    EQUB CUBE_EDGES
    EQUW icosahedron_vertices
    EQUB ICOSAHEDRON_VERTICES
    EQUW icosahedron_edges
    EQUB ICOSAHEDRON_EDGES
.objects_end
ASSERT HI(objects) = HI(objects_end)    \ read_space steps the low byte alone

INCLUDE "objects.6502"

.points
    SKIP 4 * 64                 \ x, y (16-bit) for each vertex

\ Where DEMO lands, it copies itself to RUN_AT and starts. Only relative
\ branches and zero page here, so it runs wherever it was loaded.
.relocate
{
    lda #LO(LOAD_AT)
    sta &70
    lda #HI(LOAD_AT)
    sta &71
    lda #LO(RUN_AT)
    sta &72
    lda #HI(RUN_AT)
    sta &73
    ldx #HI(end - RUN_AT + 255)
    ldy #0
.copy
    lda (&70), Y
    sta (&72), Y
    iny
    bne copy
    inc &71
    inc &73
    dex
    bne copy
    jmp start
}
.end

SAVE "DEMO", RUN_AT, end, relocate - RUN_AT + LOAD_AT, LOAD_AT
